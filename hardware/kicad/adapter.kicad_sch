(text "Crosstrainer adapter board: ESP32 <-> console link (4-pin SENSOR plug at the top of the column)" (exclude_from_sim no) (at 15.00 15.00 0) (effects (font (size 2.0 2.0) (bold yes)) (justify left bottom)) (uuid "b4a16089-cbe1-418f-953e-a093148c805b"))
(text "SNIFF mode: console plugged into J2, JP1 open, ESP32 listens (GPIO25/26/34). DRIVE mode: console unplugged, JP1 closed, ESP32 drives DOUT via Q1." (exclude_from_sim no) (at 15.00 19.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "5d0d9e5b-5264-4722-a7ab-751c7dbbb699"))
(text "Wire colours at plug A: pin1 green = 5V (from brake board), pin2 red = DOUT (brake command), pin3/pin4 yellow+black = GND and speed pulse, order to be measured (session 3)." (exclude_from_sim no) (at 15.00 23.00 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "95780e20-0af5-437c-a032-4be999765090"))
